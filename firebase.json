{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/*ACCESOS*",
      "**/*PROPUESTA*",
      "**/.*",
      "**/.env*",
      "**/*CUENTAS*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "cleanUrls": true
  }
}